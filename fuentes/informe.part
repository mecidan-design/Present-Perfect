<script id="report-block">
/* ============================================================
   EL INFORME PARA LA DOCENTE
   ============================================================
   Un solo modulo para las catorce paginas. NO toca ningun motor:
   lee lo que ya esta en pantalla cuando el alumno aprieta "Check
   my answers" (las medallas, los carteles de explicacion, los
   inputs marcados en rojo) y lo guarda en el navegador.

   Todo el sitio vive en el mismo dominio, asi que el home puede
   juntar lo de todas las paradas y mandar un solo informe.

   El envio va a un Web App de Apps Script pegado a la planilla de
   resultados: escribe la fila y le manda el mail a la docente que
   el alumno elige. Se intenta leyendo la respuesta del servidor, y
   si eso se cae, a ciegas. Igual siempre queda el boton de copiar,
   que funciona aunque no haya internet.
   ============================================================ */
(function(){
"use strict";

/* ---------- a donde va el resultado ----------
   Un Web App de Apps Script pegado a la planilla "Present Perfect -
   Resultados": escribe la fila y le manda el mail a la docente elegida.
   Mientras esta vacio, la tarjeta solo deja copiar el informe. */
var APPS = {
  url: "https://script.google.com/macros/s/AKfycbz4mC6wlKjs_tQHfEjCxDOfbYjYAzDui3pZFttOfFgpxhd4WpLmaE-2WRsJ_edVPz3-ow/exec"
};
var PUEDE_ENVIAR = !!APPS.url;

/* Las tres docentes. El alumno ve el nombre; lo que viaja es el mail, y el
   script del otro lado solo acepta estos tres. */
var DOCENTES = [
  { nombre: "Ani",  mail: "anabella_ld@buber.edu.ar" },
  { nombre: "Pao",  mail: "paolafreiberg@buber.edu.ar" },
  { nombre: "Mari", mail: "marisaolivero@buber.edu.ar" }
];

/* Los tres cursos. Tambien es una lista cerrada: asi en la planilla el curso
   se puede filtrar y ordenar, en vez de tener "6-1", "6 1", "sexto 1"... */
var CURSOS = ["6-1", "6-2", "6-3"];

var KEY = "ppq.report.v1";
var wrap = document.querySelector(".wrap");
if(!wrap) return;

/* ---------- memoria del navegador, siempre con red ---------- */
function leer(){
  try{
    var raw = window.localStorage.getItem(KEY);
    var o = raw ? JSON.parse(raw) : null;
    if(!o || typeof o !== "object") o = {};
    if(!o.stops) o.stops = {};
    return o;
  }catch(e){ return { stops: {} }; }
}
function guardar(o){
  try{ window.localStorage.setItem(KEY, JSON.stringify(o)); }catch(e){}
}

/* ---------- que pagina es esta ---------- */
function slug(){
  var p = window.location.pathname.split("/").pop() || "index.html";
  return p.replace(/\.html?$/i, "") || "index";
}
var SLUG = slug();
/* El home se reconoce por sus tarjetas de parada, no por el nombre del
   archivo: abierto desde un pendrive la URL no sirve de nada. */
var ES_HOME = !!document.querySelector(".stop a.enter");
function tituloPagina(){
  var h = document.querySelector(".hero h1") || document.querySelector("h1");
  return h ? h.textContent.trim() : document.title;
}

/* ---------- helpers ---------- */
function texto(n){ return n ? String(n.textContent).replace(/\s+/g, " ").trim() : ""; }
function parseScore(s){
  var m = /(\d+)\s*\/\s*(\d+)/.exec(s || "");
  return m ? { got: parseInt(m[1], 10), total: parseInt(m[2], 10) } : null;
}

/* ============================================================
   LEER LA PANTALLA
   Cinco de las seis clases de pagina muestran las medallas con
   el nombre del trial y el puntaje; los errores salen de las
   cajas de explicacion en rojo.
   ============================================================ */
function numeroDe(caja){
  /* la caja pegada al item: el numero esta en el .rn de arriba */
  var it = caja.closest ? caja.closest(".item") : null;
  if(it){
    var rn = it.querySelector(".rn");
    if(rn) return { n: texto(rn), cont: it };
  }
  /* la caja del panel numerado: el numero es el hermano .en */
  var pi = caja.parentNode;
  if(pi && pi.className && String(pi.className).indexOf("expitem") >= 0){
    var en = pi.querySelector(".en");
    return { n: texto(en), cont: null };
  }
  return { n: "", cont: null };
}
function loQueEscribio(cont, n, tarjeta){
  var partes = [], i;
  /* lo que quedo marcado en rojo dentro del item */
  var malos = cont ? cont.querySelectorAll("input.no, select.no, .schip.no") : [];
  for(i = 0; i < malos.length; i++){
    var v = malos[i].value !== undefined ? malos[i].value : texto(malos[i]);
    partes.push(String(v).trim() || "-");
  }
  if(partes.length) return partes.join(" + ");
  /* si la explicacion vive en el panel, se busca el item por su numero */
  if(!cont && tarjeta && n){
    var marcas = tarjeta.querySelectorAll(".rn, .sn, .gn");
    for(i = 0; i < marcas.length; i++){
      if(texto(marcas[i]) === n){
        var padre = marcas[i].parentNode;
        if(padre && padre.className && String(padre.className).indexOf("schip") >= 0){
          /* la piedra guarda la columna en .value; el texto de la piedra va
             despues del numerito, y el numerito se saca por su largo (no con
             una expresion, que se comeria una piedra como "2019") */
          var col = String(padre.value || "").trim();
          var etiqueta = texto(padre);
          var sn = padre.querySelector(".sn");
          if(sn) etiqueta = etiqueta.slice(texto(sn).length).trim();
          return col ? (col + " " + etiqueta) : "-";
        }
        var caja2 = padre ? padre.parentNode : null;
        var ins = caja2 ? caja2.querySelectorAll("input.no, .pickbtn.bad") : [];
        if(ins.length){
          var out = [];
          for(var k = 0; k < ins.length; k++){
            out.push(String(ins[k].value !== undefined && ins[k].value !== "" ? ins[k].value : texto(ins[k])).trim() || "-");
          }
          return out.join(" + ");
        }
      }
    }
  }
  return "-";
}
function mirarPantalla(){
  var partes = [], errores = [], i;

  var medallas = document.querySelectorAll(".medal");
  for(i = 0; i < medallas.length; i++){
    var nom = texto(medallas[i].querySelector(".mt"));
    var sc = parseScore(texto(medallas[i].querySelector(".ms")));
    if(nom) partes.push({ name: nom, got: sc ? sc.got : null, total: sc ? sc.total : null });
  }

  /* si no hay medallas, vale cualquier marcador de la pagina */
  if(!partes.length){
    var lineas = document.querySelectorAll(".scoreline");
    for(i = 0; i < lineas.length; i++){
      var s2 = parseScore(texto(lineas[i]));
      if(s2) partes.push({ name: "Exercise " + (partes.length + 1), got: s2.got, total: s2.total });
    }
  }

  /* las puertas de la ciudadela: cada juego ganado deja su insignia */
  var insignias = document.querySelectorAll(".gamecard .done");
  if(insignias.length){
    var abiertas = 0;
    for(i = 0; i < insignias.length; i++){
      if(String(insignias[i].className).indexOf("hidden") < 0) abiertas++;
    }
    partes.push({ name: "Doors open", got: abiertas, total: insignias.length });
  }

  var malas = document.querySelectorAll(".exp.wrong");
  for(i = 0; i < malas.length; i++){
    var caja = malas[i];
    var tarjeta = caja.closest ? caja.closest(".card") : null;
    var quien = tarjeta ? texto(tarjeta.querySelector("h2")) : "";
    var d = numeroDe(caja);
    var sol = texto(caja.querySelector(".sol")).replace(/^Answer:\s*/i, "");
    var escribio = loQueEscribio(d.cont, d.n, tarjeta);
    /* El speed run del Vault muestra su explicacion sin numero ni linea de
       respuesta: sin eso el renglon no le dice nada a la docente, asi que no
       va. El puntaje de la carrera igual queda arriba. */
    if(sol || escribio !== "-"){
      errores.push({ trial: quien, n: d.n, right: sol, was: escribio });
    }
  }

  var got = 0, total = 0;
  for(i = 0; i < partes.length; i++){
    if(partes[i].total){ got += partes[i].got || 0; total += partes[i].total; }
  }
  /* Entrar a una pagina no es haberla hecho: hasta que no corrige algo o gana
     algo, no hay nada que contar. Si no, la ciudadela recien abierta ya
     informaria "0 / 5 puertas". */
  var hizo = (got > 0) || document.querySelectorAll(".exp").length > 0;
  return { parts: partes, wrong: errores, got: got, total: total, hizo: hizo };
}

/* ---------- guardar lo de esta parada ---------- */
function anotar(){
  if(ES_HOME) return null;
  var r = mirarPantalla();
  if(!r.total || !r.hizo) return r;
  var o = leer();
  o.stops[SLUG] = {
    title: tituloPagina(),
    got: r.got, total: r.total,
    parts: r.parts, wrong: r.wrong,
    when: new Date().toISOString().slice(0, 10)
  };
  guardar(o);
  return r;
}

/* ============================================================
   EL TEXTO DEL INFORME
   ============================================================ */
function bloque(titulo, d){
  var L = [], i;
  L.push(titulo.toUpperCase() + "  -  " + d.got + " / " + d.total);
  for(i = 0; i < d.parts.length; i++){
    var p = d.parts[i];
    if(p.total) L.push("   " + p.name + ": " + p.got + " / " + p.total);
  }
  if(d.wrong && d.wrong.length){
    L.push("   To look at again:");
    for(i = 0; i < d.wrong.length; i++){
      var w = d.wrong[i];
      L.push("    - " + (w.trial ? w.trial + " " : "") + (w.n ? "(" + w.n + ") " : "")
             + "wrote: " + w.was + "  ->  right: " + w.right);
    }
  }
  return L.join("\n");
}
function informe(){
  var o = leer(), L = [], k;
  if(ES_HOME){
    var hubo = false, got = 0, total = 0;
    for(k in o.stops){
      if(Object.prototype.hasOwnProperty.call(o.stops, k)){
        var d = o.stops[k];
        L.push(bloque(d.title + "  (" + d.when + ")", d));
        L.push("");
        got += d.got; total += d.total;
        hubo = true;
      }
    }
    if(!hubo) return null;
    L.unshift("WHOLE QUEST: " + got + " / " + total + "\n");
    return { texto: L.join("\n"), got: got, total: total, stop: "Whole quest" };
  }
  var r = mirarPantalla();
  if(!r.total || !r.hizo) return null;
  return { texto: bloque(tituloPagina(), r), got: r.got, total: r.total, stop: tituloPagina() };
}

/* ============================================================
   LA TARJETA
   ============================================================ */
var opciones = "";
for(var di = 0; di < DOCENTES.length; di++){
  opciones += '<option value="' + DOCENTES[di].mail + '">' + DOCENTES[di].nombre + '</option>';
}
var cursos = "";
for(var ci = 0; ci < CURSOS.length; ci++){
  cursos += '<option value="' + CURSOS[ci] + '">' + CURSOS[ci] + '</option>';
}

var card = document.createElement("section");
card.className = "card rpcard";
card.innerHTML =
  '<span class="tag">Your report</span>' +
  '<h2>' + (PUEDE_ENVIAR
    ? (ES_HOME ? "Send your quest to your teacher" : "Send your result to your teacher")
    : (ES_HOME ? "Your quest so far" : "Your report")) + '</h2>' +
  '<p class="sub">' + (PUEDE_ENVIAR
    ? (ES_HOME
       ? "This is everything you have done in the quest on this computer. Write your name, choose your class &amp; your teacher and then press the button."
       : "Check your answers first. Then write your name, choose your class &amp; your teacher and then press the button.")
    : (ES_HOME
       ? "This is everything you have done in the quest on this computer. Write your name and copy it to give it to your teacher."
       : "Check your answers first, then write your name and copy your report. It says how many you got right and which ones to look at again.")) +
  '</p>' +
  '<div class="rprow">' +
    '<label>Name<input type="text" id="rpName" autocomplete="off" placeholder="Your name"></label>' +
    '<label>Class<select id="rpClass">' +
      '<option value="">Choose your class</option>' + cursos +
    '</select></label>' +
    (PUEDE_ENVIAR ? '<label>Teacher<select id="rpTeacher">' +
      '<option value="">Choose your teacher</option>' + opciones +
    '</select></label>' : "") +
  '</div>' +
  /* El informe NO se le muestra al alumno: la tarjeta es nombre, curso,
     docente y el boton. Lo que se manda sigue siendo lo mismo.
     El boton de copiar nace escondido: aparece solo si un envio falla, para
     que el chico tenga como pasarle el resultado a la docente igual. */
  '<div class="btnrow">' +
    (PUEDE_ENVIAR ? '<button class="btn" id="rpSend" type="button">Send to my teacher</button>' : "") +
    '<button class="btn ghost" id="rpCopy" type="button"' + (PUEDE_ENVIAR ? ' hidden' : '') + '>Copy my report</button>' +
  '</div>' +
  '<p class="rpmsg" id="rpMsg"></p>' +
  '<p class="rpfine">Only your name, your class and your answers go to the teacher you choose. Nothing else.</p>';

/* Va donde termina el resultado: pegada al final de los trials y antes del
   codex, no al final de todo. */
var trials = document.getElementById("trials");
var codex = document.getElementById("codexCard");
var nav = document.querySelector("nav.bottomnav");
if(trials && trials.parentNode === wrap && trials.nextSibling) wrap.insertBefore(card, trials.nextSibling);
else if(codex && codex.parentNode === wrap) wrap.insertBefore(card, codex);
else if(nav && nav.parentNode === wrap) wrap.insertBefore(card, nav);
else wrap.appendChild(card);

var elName = document.getElementById("rpName");
var elClass = document.getElementById("rpClass");
var elTeacher = document.getElementById("rpTeacher");
var elMsg = document.getElementById("rpMsg");
var elSend = document.getElementById("rpSend");
var elCopy = document.getElementById("rpCopy");

/* Las tres casillas arrancan VACIAS, siempre, en todas las paginas.
   Antes se recordaban para que el chico escribiera su nombre una sola vez, y
   estaba mal: estas maquinas se comparten. El que se sentaba despues se
   encontraba el nombre, el curso y la docente del anterior ya puestos, y con
   apretar el boton mandaba su trabajo con el nombre de otro, o a la docente
   equivocada. Se escribe cada vez: son cinco segundos. */
(function limpiarViejo(){
  /* y se borra lo que haya quedado guardado de la version anterior */
  var o = leer();
  if(o.name || o.klass || o.teacher){
    delete o.name; delete o.klass; delete o.teacher;
    guardar(o);
  }
})();

/* ---------- el boton que baja hasta la tarjeta ----------
   Va en la misma fila que "Check my answers", que es donde el alumno esta
   mirando cuando aparece el puntaje. */
function ponerAtajos(){
  var cards = document.querySelectorAll("#trials .card, .gamecard");
  for(var i = 0; i < cards.length; i++){
    var c = cards[i];
    if(c === card || c.querySelector(".rpjump")) continue;
    /* Hay resultado cuando el marcador tiene un numero (los trials) o cuando
       la insignia de puerta ganada dejo de estar oculta (la ciudadela). */
    var marcador = c.querySelector(".scoreline");
    var insignia = c.querySelector(".done");
    var hay = (marcador && /[0-9]/.test(texto(marcador))) ||
              (insignia && String(insignia.className).indexOf("hidden") < 0);
    if(!hay) continue;
    var fila = c.querySelector(".btnrow");
    if(!fila) continue;
    var b = document.createElement("button");
    b.type = "button";
    b.className = "btn ghost rpjump";
    b.textContent = PUEDE_ENVIAR ? "Send this to my teacher" : "See my report";
    b.addEventListener("click", function(){
      card.scrollIntoView({ block: "start" });
      elName.focus();
    });
    fila.appendChild(b);
  }
}

var enviado = null;   /* el texto del ultimo informe que salio */

function pintar(){
  var r = informe();
  ponerAtajos();
  /* Si el alumno siguio trabajando despues de enviar, el boton vuelve.
     Lo que se evita es mandar dos veces LO MISMO, no que entregue el trial
     que hizo despues. */
  if(elSend && enviado !== null && r && r.texto !== enviado){
    elSend.disabled = false;
    elSend.textContent = "Send my new result";
  }
}

/* cada click puede cambiar el puntaje: se vuelve a mirar la pantalla */
var pend = null;
document.addEventListener("click", function(){
  if(pend) window.clearTimeout(pend);
  pend = window.setTimeout(function(){ anotar(); pintar(); }, 250);
}, true);
window.addEventListener("pagehide", function(){ anotar(); });

function aviso(t, bien){
  elMsg.textContent = t;
  elMsg.className = "rpmsg " + (bien ? "ok" : "no");
}
function cabecera(){
  return "PRESENT PERFECT QUEST\n" +
         "Student: " + (elName.value.trim() || "(no name)") +
         "   Class: " + (elClass.value || "-") +
         "   Date: " + new Date().toISOString().slice(0, 10);
}

/* ---------- copiar: el plan B, escondido hasta que algo falle ---------- */
elCopy.addEventListener("click", function(){
  var r = informe();
  if(!r){ aviso("There is nothing to send yet.", false); return; }
  var t = cabecera() + "\n" + r.texto;
  var ok = false;
  try{
    if(navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(t);
      ok = true;
    }
  }catch(e){}
  if(!ok){
    try{
      var ta = document.createElement("textarea");
      ta.value = t;
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.select();
      ok = document.execCommand("copy");
      document.body.removeChild(ta);
    }catch(e2){ ok = false; }
  }
  aviso(ok ? "Copied. Now give it to your teacher the way she asks you to."
           : "Your report could not be copied. Tell your teacher.", ok);
});

/* ============================================================
   ENVIAR AL WEB APP
   ============================================================ */
if(elSend){
  elSend.addEventListener("click", function(){
    var r = informe();
    if(!elName.value.trim()){ aviso("Write your name first.", false); elName.focus(); return; }
    if(!elClass.value){ aviso("Choose your class first.", false); elClass.focus(); return; }
    if(!elTeacher.value){ aviso("Choose your teacher first.", false); elTeacher.focus(); return; }
    if(!r){ aviso("There is nothing to send yet. Check your answers first.", false); return; }

    var datos = {
      nombre_alumno: elName.value.trim(),
      curso: elClass.value,
      docente: elTeacher.value,
      docente_nombre: elTeacher.options[elTeacher.selectedIndex].textContent,
      pagina: r.stop,
      puntaje: r.got + " / " + r.total,
      resultado: r.texto,
      timestamp: new Date().toISOString()
    };

    elSend.disabled = true;
    aviso("Sending...", true);

    var cuerpo = JSON.stringify(datos);
    /* El Content-Type va como texto plano a proposito: en no-cors el navegador
       solo acepta unos pocos, y con application/json ni sale el pedido. Del
       otro lado Apps Script lo lee igual con JSON.parse. */
    var cabeceras = { "Content-Type": "text/plain;charset=utf-8" };

    var bien = function(txt){
      enviado = r.texto;
      elSend.textContent = "Sent";
      elCopy.hidden = true;
      aviso("Sent to " + datos.docente_nombre + (txt ? ". " + txt : ".")
            + " If you do more, the button comes back.", true);
    };
    var mal = function(txt, conCopia){
      elSend.disabled = false;
      /* el cartel del boton vuelve a invitar: si quedaba "Sent" el alumno
         piensa que ya esta entregado */
      elSend.textContent = (enviado === null) ? "Send to my teacher" : "Send my new result";
      /* recien ahora aparece el plan B: el chico puede copiar su informe y
         darselo a la docente por otro camino. No cuando el problema es que ya
         lo mando hace un momento: ahi no falta nada. */
      if(conCopia !== false) elCopy.hidden = false;
      aviso(txt || "It did not go. Press the button again, or copy your report and give it to your teacher.", false);
    };

    /* ================== LEER ESTO ==================
       Primero se intenta en modo CORS, que es el bueno: Apps Script devuelve
       las cabeceras necesarias, asi que se puede LEER la respuesta y saber de
       verdad si el servidor escribio la fila ({"status":"ok"}) o si la
       rechazo. Ese "Sent" no es optimista: es lo que contesto el servidor.

       Si ese camino falla -sin internet, o un filtro de la escuela que corta
       la lectura de la respuesta- se reintenta en no-cors. AHI SI la respuesta
       es OPACA: el navegador no deja ver ni el codigo de estado ni el cuerpo,
       asi que "el pedido salio" es todo lo que sabemos. NO prueba que el
       servidor lo haya recibido, ni que se haya escrito la fila, ni que el
       mail haya salido. Por eso en ese caso el cartel lo dice distinto, y la
       unica prueba de verdad sigue estando en la planilla.
       =============================================== */
    var aCiegas = function(){
      try{
        window.fetch(APPS.url, { method: "POST", mode: "no-cors", headers: cabeceras, body: cuerpo })
          .then(function(){ bien("It could not be confirmed, so check with your teacher."); }, function(){ mal(); });
      }catch(e2){ mal(); }
    };

    try{
      window.fetch(APPS.url, { method: "POST", headers: cabeceras, body: cuerpo })
        .then(function(resp){ return resp.text(); })
        .then(function(txt){
          var o;
          try{ o = JSON.parse(txt); }catch(e3){ o = null; }
          if(o && o.status === "ok"){ bien(""); }
          else if(o && o.message === "ya enviado, espera un momento"){
            mal("You just sent this one. Wait a moment before sending it again.", false);
          }
          else if(o){ mal("The teacher's list did not take it. Tell your teacher."); }
          else { aCiegas(); }
        }, aCiegas);
    }catch(e){ aCiegas(); }
  });
}

anotar();
pintar();
})();
</script>
