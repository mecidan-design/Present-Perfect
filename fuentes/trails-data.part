  type: "duo",
  w1: "w-xs", w2: "w-s", hintAfter: 2,
  note: {
    title: "The order of a How long question",
    lines: [
      "How long + have / has + person + past participle + the rest? -> How long have you had that bike?",
      "The answer uses the same present perfect -> I have had it for three years."
    ],
    warning: "The auxiliary goes before the person, not after it. How long you have had...? is wrong."
  },
  example: { n: 0, before: "How long", gap1: "have", mid: "you", gap2: "had", verb: "have", after: "that bike?" },
  items: [
    { n: 1, before: "How long", mid: "your parents", verb: "live", after: "in this city?",
      answers1: ["have"], answers2: ["lived"],
      solution: "How long have your parents lived in this city?",
      why: "Your parents are two people, so the question starts with have, and live is regular: lived.",
      tip: "Plural people always take have, never has." },
    { n: 2, before: "How long", mid: "your best friend", verb: "have", after: "that school bag?",
      answers1: ["has"], answers2: ["had"],
      solution: "How long has your best friend had that school bag?",
      why: "Your best friend is one person, so the question starts with has, and the past participle of have is had.",
      tip: "has ... had is correct: the first is the auxiliary, the second is the verb." },
    { n: 3, before: "How long", mid: "you", verb: "study", after: "in this school?",
      answers1: ["have"], answers2: ["studied"],
      solution: "How long have you studied in this school?",
      why: "You always takes have, and study is regular, but the y becomes ied: studied.",
      tip: "study - studied, like try - tried. There is a consonant before the y." },
    { n: 4, before: "How long", mid: "the shop", verb: "be", after: "open?",
      answers1: ["has"], answers2: ["been"],
      solution: "How long has the shop been open?",
      why: "The shop is one thing, so the question starts with has, and the past participle of be is been.",
      tip: "For one thing or one person the word is has, exactly like for he and she." },
    { n: 5, before: "How long", mid: "your English teacher", verb: "work", after: "here?",
      answers1: ["has"], answers2: ["worked"],
      solution: "How long has your English teacher worked here?",
      why: "Your English teacher is one person, so it takes has, and work is regular: worked.",
      tip: "Nothing changes in work: you only add -ed." }
  ]
},

/* ============================================================
   TRIAL VI - corregir los errores (hoja, ejercicio 4)
   ============================================================ */
{
  key: "t6", icon: "crown",
  medal: "Mistakes",
  title: "Hunt the Mistake",
  sub: "Every sentence has one mistake. Write the whole sentence again, correctly. Number 0 is done for you.",
  type: "write",
  note: {
    title: "Where the mistake usually is",
    lines: [
      "from instead of since -> from I was ten becomes since I was ten.",
      "since with a length of time -> since a month becomes for a month.",
      "for with a point in time -> for 2018 becomes since 2018.",
      "the verb is not the past participle -> has play becomes has played."
    ],
    warning: "Copy the rest of the sentence exactly as it is. Only the mistake changes."
  },
  example: { n: 0, prompt: "It has been my hobby from I was ten years old.", gap: "It has been my hobby since I was ten years old." },
  items: [
    { n: 1, prompt: "I have needed a new bag since a month.",
      answers: ["i have needed a new bag for a month","i've needed a new bag for a month"],
      solution: "I have needed a new bag for a month.",
      why: "A month is an amount of time, not the moment it started, so the word has to be for.",
      tip: "a month, a week, a year: all of them are lengths, so all of them take for." },
    { n: 2, prompt: "My family have lived here for 2018.",
      answers: ["my family have lived here since 2018","my family has lived here since 2018","my family've lived here since 2018"],
      solution: "My family have lived here since 2018.",
      why: "2018 is a year, so it is the point in time when they started living here, and points take since.",
      tip: "Careful with years: since 2018, but for eight years." },
    { n: 3, prompt: "I have wanted that T-shirt since several weeks.",
      answers: ["i have wanted that t shirt for several weeks","i've wanted that t shirt for several weeks","i have wanted that tshirt for several weeks","i've wanted that tshirt for several weeks"],
      solution: "I have wanted that T-shirt for several weeks.",
      why: "Several weeks measures how long, so the sentence needs for and not since.",
      tip: "If the time expression has a number or a word like several, it is a length: for." },
    { n: 4, prompt: "She has play the piano for six years.",
      answers: ["she has played the piano for six years","she's played the piano for six years"],
      solution: "She has played the piano for six years.",
      why: "After has the verb must be the past participle, and play is regular: played.",
      tip: "After has the verb always changes: play becomes played." },
    { n: 5, prompt: "We know each other since we were five.",
      answers: ["we have known each other since we were five","we've known each other since we were five"],
      solution: "We have known each other since we were five.",
      why: "The action started in the past and it is still true, so the sentence needs the present perfect: have known.",
      tip: "know - knew - known. After have you need known, with an n." },
    { n: 6, prompt: "How long you have had that watch?",
      answers: ["how long have you had that watch"],
      solution: "How long have you had that watch?",
      why: "In a question the auxiliary goes before the person: How long have you...?",
      tip: "Statement: You have had it. Question: Have you had it? The first two words change places." }
  ]
}

],

