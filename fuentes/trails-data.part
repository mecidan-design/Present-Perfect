  words: ["one","two","three","four","five","six","seven","eight","nine","ten"],
  hint: "The arrow is always the same arrow. SINCE points at the stone where it begins. FOR measures how long it is.",
  note: "The action started in the past and it is still true today. That is why we use the present perfect and not the past simple."
},

trials: [

