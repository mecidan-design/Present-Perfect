<script id="engine-block">
(function(){
"use strict";

/* ===== registry: el DOM guarda SOLO un indice numerico ===== */
var REG = [];

/* ===== iconos svg estaticos (decorativos) ===== */
var ICONS = {
  shield: '<svg class="ic" viewBox="0 0 24 24"><path d="M12 2 20.5 5v6.2c0 5.2-3.6 9.2-8.5 10.8C7.1 20.4 3.5 16.4 3.5 11.2V5z"/></svg>',
  scroll: '<svg class="ic" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M6 2h11a2.5 2.5 0 0 1 2.5 2.5V18a4 4 0 0 0 4 4H8a4 4 0 0 1-4-4V4.5A2.5 2.5 0 0 1 6 2zm2 5h9v2H8zm0 4h9v2H8zm0 4h6v2H8z"/></svg>',
  star:   '<svg class="ic" viewBox="0 0 24 24"><path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5L2.6 9.4l6.5-.9z"/></svg>',
  crown:  '<svg class="ic" viewBox="0 0 24 24"><path d="M3 7.5l4 3.2L12 4l5 6.7 4-3.2-1.9 11.3H4.9z"/></svg>',
  bolt:   '<svg class="ic" viewBox="0 0 24 24"><path d="M13 2 4 13.5h6L11 22l9-11.5h-6z"/></svg>',
  flame:  '<svg class="ic" viewBox="0 0 24 24"><path d="M12 2c3.2 4.2 6.2 5.6 6.2 9.8A6.2 6.2 0 0 1 5.8 12c0-2.2 1.1-3.7 2.3-4.9.3 1.4 1 2.1 1.9 2.4C10.3 7.2 11 4.6 12 2z"/></svg>',
  glass:  '<svg class="ic" viewBox="0 0 24 24"><path d="M6 2h12v2h-1v2.5L13.2 12 17 17.5V20h1v2H6v-2h1v-2.5L10.8 12 7 6.5V4H6z"/></svg>'
};
function icon(name){
  var s = document.createElement("span");
  s.innerHTML = ICONS[name] || "";
  return s.firstChild;
}
function el(tag, cls, txt){
  var n = document.createElement(tag);
  if(cls) n.className = cls;
  if(txt !== undefined && txt !== null) n.textContent = txt;
  return n;
}
function clear(n){ while(n.firstChild) n.removeChild(n.firstChild); }

/* Caja Why + Hero tip. En el review aparece SIEMPRE, este bien o mal. */
function explainBox(ok, why, tip){
  var box = el("div", "exp " + (ok ? "right" : "wrong"));
  var p1 = el("p");
  p1.appendChild(el("b", "lab why", "Why"));
  p1.appendChild(document.createTextNode(why));
  box.appendChild(p1);
  var p2 = el("p");
  p2.appendChild(el("b", "lab tip", "Hero tip"));
  p2.appendChild(document.createTextNode(tip));
  box.appendChild(p2);
  return box;
}

/* ============================================================
   CABECERA + MEDALLAS (last run / best run / best streak)
   ============================================================ */
document.title = DATA.meta.title + " - " + DATA.meta.chapter;
document.getElementById("heroChapter").textContent = DATA.meta.chapter;
document.getElementById("heroTitle").textContent = DATA.meta.title;
document.getElementById("heroSub").textContent = DATA.meta.sub;
document.getElementById("heroVerbs").innerHTML = DATA.meta.verbs;

var BEST_KEY = "ppq-irregular-speedrun.best";
var MEDALS = [
  { key: "last",   label: "Last run",    ic: "bolt"  },
  { key: "best",   label: "Best run",    ic: "crown" },
  { key: "streak", label: "Best streak", ic: "flame" }
];
var questBar = document.getElementById("questBar");
var medalEls = {};
(function(){
  for(var i = 0; i < MEDALS.length; i++){
    var m = MEDALS[i];
    var d = el("div", "medal");
    var mi = el("div", "mi");
    mi.appendChild(icon(m.ic));
    var txt = el("div");
    txt.appendChild(el("div", "mt", m.label));
    var sc = el("div", "ms", "not tried yet");
    txt.appendChild(sc);
    d.appendChild(mi);
    d.appendChild(txt);
    questBar.appendChild(d);
    medalEls[m.key] = { wrap: d, score: sc };
  }
})();

/* El record vive en el navegador del chico. Si el localStorage esta
   bloqueado (modo incognito, politica del colegio) el juego funciona
   igual: simplemente no guarda nada. */
function readBest(){
  try{
    var raw = window.localStorage.getItem(BEST_KEY);
    if(!raw) return null;
    var p = raw.split("|");
    return { points: parseInt(p[0], 10) || 0, right: parseInt(p[1], 10) || 0,
             total: parseInt(p[2], 10) || 0, streak: parseInt(p[3], 10) || 0 };
  }catch(e){ return null; }
}
function writeBest(b){
  try{ window.localStorage.setItem(BEST_KEY, b.points + "|" + b.right + "|" + b.total + "|" + b.streak); }
  catch(e){}
}
var BEST = readBest();
function drawMedals(last){
  if(last){
    medalEls.last.score.textContent = last.right + " / " + last.total;
    if(last.right === last.total) medalEls.last.wrap.classList.add("won");
    else medalEls.last.wrap.classList.remove("won");
  }
  if(BEST){
    medalEls.best.score.textContent = BEST.points + " pts";
    medalEls.best.wrap.classList.add("won");
    medalEls.streak.score.textContent = String(BEST.streak);
    medalEls.streak.wrap.classList.add("won");
  }
}
drawMedals(null);

/* ============================================================
   LA CARRERA
   Timer por pregunta. Puntos = base + bonus por rapidez, con
   multiplicador de racha. Las explicaciones completas van al
   final, en el panel de review, para no frenar la carrera.
   ============================================================ */
var QTIME = DATA.seconds * 1000;
var srStage = document.getElementById("srStage");
var srDots  = document.getElementById("srDots");
var srScore = document.getElementById("srScore");
var srStreakEl = document.getElementById("srStreak");
var srComboEl  = document.getElementById("srCombo");
var srClock = document.getElementById("srClock");
var srTimer = document.getElementById("srTimer");
var srBar   = document.getElementById("srTimerBar");

function freshS(){ return { i: -1, points: 0, streak: 0, best: 0, right: 0, elapsed: 0, qStart: 0, results: [], deck: [] }; }
var S = freshS(), tickHandle = null, runHandle = null;

/* Baraja de Fisher-Yates: cada carrera sale en otro orden, asi el chico
   memoriza el verbo y no la posicion del boton. */
function shuffled(n){
  var a = [], i, j, t;
  for(i = 0; i < n; i++) a.push(i);
  for(i = a.length - 1; i > 0; i--){
    j = Math.floor(Math.random() * (i + 1));
    t = a[i]; a[i] = a[j]; a[j] = t;
  }
  return a;
}
function comboOf(streak){
  if(streak >= 6) return 3;
  if(streak >= 3) return 2;
  return 1;
}
function drawSRHud(){
  clear(srScore);
  srScore.appendChild(icon("star"));
  srScore.appendChild(document.createTextNode(" " + S.points + " pts"));
  clear(srStreakEl);
  srStreakEl.appendChild(icon("flame"));
  srStreakEl.appendChild(document.createTextNode(" Streak " + S.streak));
  srComboEl.textContent = "x" + comboOf(S.streak) + " combo";
  clear(srClock);
  srClock.appendChild(icon("glass"));
  srClock.appendChild(document.createTextNode(" " + (S.elapsed / 1000).toFixed(1) + "s"));
}
function drawSRDots(){
  clear(srDots);
  for(var i = 0; i < S.deck.length; i++){
    var cls = "dot";
    if(S.results[i] === true) cls += " y";
    else if(S.results[i] === false) cls += " n";
    if(i === S.i) cls += " now";
    srDots.appendChild(el("span", cls));
  }
}
function stopTimers(){
  if(tickHandle){ clearInterval(tickHandle); tickHandle = null; }
  if(runHandle){ clearInterval(runHandle); runHandle = null; }
}
function srQuestion(){
  stopTimers();
  drawSRDots();
  drawSRHud();
  srTimer.classList.remove("hidden");
  srTimer.classList.remove("low");
  srBar.style.width = "100%";
  clear(srStage);
  REG.length = 0;

  var d = DATA.verbs[S.deck[S.i]];
  var id = REG.push({ data: d }) - 1;

  var box = el("div", "qbox");
  box.appendChild(el("div", "vhint", "Verb " + (S.i + 1) + " of " + S.deck.length));
  box.appendChild(el("div", "vword", d.q));
  box.appendChild(el("div", "vhint", "What is the past participle?"));
  var opts = el("div", "opts");
  for(var j = 0; j < d.options.length; j++){
    var b = el("button", "opt", d.options[j]);
    b.type = "button";
    b.setAttribute("data-sid", String(id));
    b.setAttribute("data-opt", String(j));
    b.addEventListener("click", onSRAnswer);
    opts.appendChild(b);
  }
  box.appendChild(opts);
  srStage.appendChild(box);

  S.qStart = Date.now();
  tickHandle = setInterval(function(){
    var left = QTIME - (Date.now() - S.qStart);
    if(left <= 0){ srResolve(box, id, -1, 0); return; }
    var frac = left / QTIME;
    srBar.style.width = (frac * 100).toFixed(1) + "%";
    if(frac < .3) srTimer.classList.add("low");
  }, 60);
  runHandle = setInterval(function(){
    S.elapsed = S.elapsed + 100;
    drawSRHud();
  }, 100);
}
function onSRAnswer(ev){
  var b = ev.currentTarget;
  var id = parseInt(b.getAttribute("data-sid"), 10);
  var j  = parseInt(b.getAttribute("data-opt"), 10);
  var left = Math.max(0, QTIME - (Date.now() - S.qStart));
  srResolve(b.parentNode.parentNode, id, j, left / QTIME);
}
function srResolve(box, id, picked, frac){
  stopTimers();
  var d = REG[id].data;
  var ok = picked === d.correct;

  var btns = box.querySelectorAll(".opt");
  for(var k = 0; k < btns.length; k++){
    btns[k].disabled = true;
    if(k === d.correct) btns[k].classList.add("good");
    else if(k === picked) btns[k].classList.add("bad");
  }

  S.results[S.i] = ok;
  if(ok){
    S.streak++;
    if(S.streak > S.best) S.best = S.streak;
    var gained = Math.round((100 + 100 * frac) * comboOf(S.streak));
    S.points = S.points + gained;
    S.right++;
    box.appendChild(el("div", "flash y", "+" + gained + " points"));
  } else {
    S.streak = 0;
    box.appendChild(el("div", "flash n", picked === -1 ? "Time is up." : "Not this one."));
  }
  box.appendChild(el("div", "pair", d.q.toLowerCase() + "  →  " + d.options[d.correct]));
  drawSRHud();
  drawSRDots();

  var row = el("div", "btnrow");
  row.style.justifyContent = "center";
  var next = el("button", "btn", S.i === S.deck.length - 1 ? "See my run" : "Next verb");
  next.type = "button";
  next.addEventListener("click", function(){
    if(S.i === S.deck.length - 1){ srFinal(); }
    else { S.i++; srQuestion(); }
  });
  row.appendChild(next);
  box.appendChild(row);
}
function srFinal(){
  stopTimers();
  S.i = -1;
  drawSRDots();
  srTimer.classList.add("hidden");
  var total = S.deck.length;
  var msg;
  if(S.right === total) msg = "Perfect run. Not one participle escaped.";
  else if(S.right >= total - 2) msg = "Strong run. Two more and the vault is yours.";
  else if(S.right >= total / 2) msg = "Good start. Read the scroll below, then run again.";
  else msg = "The verbs won this time. Read the scroll and run again.";

  var isBest = !BEST || S.points > BEST.points;
  if(isBest){
    BEST = { points: S.points, right: S.right, total: total, streak: S.best };
    writeBest(BEST);
  }else if(S.best > BEST.streak){
    BEST.streak = S.best;
    writeBest(BEST);
  }
  drawMedals({ right: S.right, total: total });

  clear(srStage);
  var f = el("div", "final");
  f.appendChild(el("div", "big", S.points + " pts"));
  f.appendChild(el("div", "msg", msg));
  var st = el("div", "stats");
  st.appendChild(document.createTextNode("Correct: " + S.right + " / " + total));
  st.appendChild(document.createElement("br"));
  st.appendChild(document.createTextNode("Best streak in this run: " + S.best));
  st.appendChild(document.createElement("br"));
  st.appendChild(document.createTextNode("Time: " + (S.elapsed / 1000).toFixed(1) + " seconds"));
  if(isBest){
    st.appendChild(document.createElement("br"));
    st.appendChild(document.createTextNode("This is your best run on this computer."));
  }
  f.appendChild(st);
  var again = el("button", "btn", "Back to the start");
  again.type = "button";
  again.addEventListener("click", srReady);
  f.appendChild(again);

  /* review: TODOS los verbos de la carrera, bien o mal, con Why + Hero tip */
  var rev = el("div", "review");
  var h = el("h3");
  h.appendChild(icon("scroll"));
  h.appendChild(document.createTextNode(" The scroll of this run"));
  rev.appendChild(h);
  for(var i = 0; i < S.deck.length; i++){
    var d = DATA.verbs[S.deck[i]];
    var ok = S.results[i] === true;
    var ri = el("div", "ritem");
    var top = el("div", "rtop");
    top.appendChild(document.createTextNode((i + 1) + ". " + d.q.toLowerCase() + " → " + d.options[d.correct]));
    top.appendChild(el("span", "mark " + (ok ? "y" : "n"), ok ? "right" : "review"));
    ri.appendChild(top);
    var ex = explainBox(ok, d.why, d.tip);
    ex.style.marginTop = "6px";
    ri.appendChild(ex);
    rev.appendChild(ri);
  }
  f.appendChild(rev);
  srStage.appendChild(f);
}
function startRun(howMany){
  S = freshS();
  var order = shuffled(DATA.verbs.length);
  S.deck = order.slice(0, Math.min(howMany, order.length));
  S.i = 0;
  srQuestion();
}

/* Pantalla de salida. El cronometro NO puede arrancar solo al abrir el
   archivo: si no, la primera pregunta se vence mientras el chico todavia
   esta leyendo el titulo de la pagina. Arranca cuando el aprieta. */
function srReady(){
  stopTimers();
  S = freshS();
  srTimer.classList.add("hidden");
  clear(srDots);
  drawSRHud();
  clear(srStage);
  var box = el("div", "qbox");
  box.appendChild(el("div", "vhint", DATA.verbs.length + " irregular verbs · " + DATA.seconds + " seconds each"));
  box.appendChild(el("div", "vword", "READY?"));
  box.appendChild(el("p", "qsent", "The faster you answer, the more points you win. Three right answers in a row give you a double combo, and six in a row give you a triple one. When the bar empties, that verb is gone. The verbs come in a different order every time."));
  if(BEST){
    box.appendChild(el("p", "vhint", "Your best run on this computer: " + BEST.points + " points, " + BEST.right + " of " + BEST.total + " right"));
  }
  var row = el("div", "btnrow");
  row.style.justifyContent = "center";
  var shortBtn = el("button", "btn", "Short run · " + DATA.shortRun + " verbs");
  shortBtn.type = "button";
  shortBtn.addEventListener("click", function(){ startRun(DATA.shortRun); });
  var fullBtn = el("button", "btn ghost", "Full run · " + DATA.verbs.length + " verbs");
  fullBtn.type = "button";
  fullBtn.addEventListener("click", function(){ startRun(DATA.verbs.length); });
  row.appendChild(shortBtn);
  row.appendChild(fullBtn);
  box.appendChild(row);
  srStage.appendChild(box);
}

/* ============================================================
   CODEX
   ============================================================ */
var codexBody = document.getElementById("codexBody");
var codexToggle = document.getElementById("codexToggle");
(function renderCodex(){
  for(var i = 0; i < DATA.codex.length; i++){
    var g = DATA.codex[i];
    var b = el("div", "gbox");
    b.appendChild(el("h4", null, g.name));
    b.appendChild(el("p", "pat", g.pattern));
    var ps = el("div", "pairs");
    for(var j = 0; j < g.pairs.length; j++){
      var c = el("span", "pchip");
      c.appendChild(document.createTextNode(g.pairs[j][0] + " → "));
      c.appendChild(el("b", null, g.pairs[j][1]));
      ps.appendChild(c);
    }
    b.appendChild(ps);
    codexBody.appendChild(b);
  }
})();
codexToggle.addEventListener("click", function(){
  var open = codexBody.classList.toggle("hidden") === false;
  codexToggle.textContent = open ? "Close the codex" : "Open the codex";
});

/* ============================================================
   ARRANQUE
   ============================================================ */
srReady();

})();
</script>
</body>
</html>
