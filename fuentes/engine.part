<script id="engine-block">
(function(){
"use strict";

/* ===== registry: el DOM guarda SOLO un indice numerico. Serializar JSON en
   un atributo data-* se rompe con los apostrofes de las contracciones. ===== */
var REG = [];

/* ===== iconos svg estaticos (decorativos) ===== */
var ICONS = {
  shield: '<svg class="ic" viewBox="0 0 24 24"><path d="M12 2 20.5 5v6.2c0 5.2-3.6 9.2-8.5 10.8C7.1 20.4 3.5 16.4 3.5 11.2V5z"/></svg>',
  sword:  '<svg class="ic" viewBox="0 0 24 24"><path d="M12 1.5l2.2 3.6v9.4h-4.4V5.1z"/><rect x="6" y="14.6" width="12" height="2.4" rx="1.2"/><rect x="10.8" y="17.2" width="2.4" height="3.6" rx="1.2"/><rect x="9.4" y="20.2" width="5.2" height="2" rx="1"/></svg>',
  scroll: '<svg class="ic" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M6 2h11a2.5 2.5 0 0 1 2.5 2.5V18a4 4 0 0 0 4 4H8a4 4 0 0 1-4-4V4.5A2.5 2.5 0 0 1 6 2zm2 5h9v2H8zm0 4h9v2H8zm0 4h6v2H8z"/></svg>',
  star:   '<svg class="ic" viewBox="0 0 24 24"><path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5L2.6 9.4l6.5-.9z"/></svg>',
  crown:  '<svg class="ic" viewBox="0 0 24 24"><path d="M3 7.5l4 3.2L12 4l5 6.7 4-3.2-1.9 11.3H4.9z"/></svg>',
  bolt:   '<svg class="ic" viewBox="0 0 24 24"><path d="M13 2 4 13.5h6L11 22l9-11.5h-6z"/></svg>',
  flame:  '<svg class="ic" viewBox="0 0 24 24"><path d="M12 2c3.2 4.2 6.2 5.6 6.2 9.8A6.2 6.2 0 0 1 5.8 12c0-2.2 1.1-3.7 2.3-4.9.3 1.4 1 2.1 1.9 2.4C10.3 7.2 11 4.6 12 2z"/></svg>'
};
function icon(name){
  var s = document.createElement("span");
  s.innerHTML = ICONS[name] || "";
  return s.firstChild;
}

/* ===== helpers ===== */
function normalize(s){
  /* normalize("NFD") separa la tilde de la letra y la clase ̀-ͯ la
     borra: asi "cafe" y "cafe" con tilde comparan igual. */
  return String(s).toLowerCase()
    .replace(/[‘’ʼ]/g, "'")
    .normalize("NFD").replace(/[̀-ͯ]/g, "")
    .replace(/[^a-z0-9' ]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}
/* ADAPTACION A PRIMARIA (se aparta a proposito del normalize del SPECS):
   a esta edad "havent" o "dont" sin apostrofe son un error de TIPEO, no de
   gramatica, y lo que se evalua es la estructura. Por eso la comparacion
   tambien se hace ciega al apostrofe. Esto NO afloja la gramatica:
   "have never grew" sigue estando mal. */
function loose(s){ return normalize(s).replace(/'/g, ""); }
function matches(given, list){
  var g = normalize(given);
  if(g === "") return false;
  var gl = loose(given);
  for(var i = 0; i < list.length; i++){
    if(normalize(list[i]) === g) return true;
    if(loose(list[i]) === gl) return true;
  }
  return false;
}
function el(tag, cls, txt){
  var n = document.createElement(tag);
  if(cls) n.className = cls;
  if(txt !== undefined && txt !== null) n.textContent = txt;
  return n;
}
function clear(n){ while(n.firstChild) n.removeChild(n.firstChild); }

/* Caja Why + Hero tip. Se muestra SIEMPRE, este bien o mal. */
function explainBox(ok, answerText, why, tip){
  var box = el("div", "exp " + (ok ? "right" : "wrong"));
  if(answerText){
    var p0 = el("p");
    p0.appendChild(el("span", "sol", "Answer: " + answerText));
    box.appendChild(p0);
  }
  var p1 = el("p");
  p1.appendChild(el("b", "lab why", "Why"));
  p1.appendChild(document.createTextNode(why));
  box.appendChild(p1);
  var p2 = el("p");
  p2.appendChild(el("b", "lab tip", "Hero tip"));
  p2.appendChild(document.createTextNode(tip));
  box.appendChild(p2);
  return box;
}
/* Caja de gramatica al estilo de las del manual. Cada linea usa " -> ". */
function noteBox(n){
  var g = el("div", "gnote");
  var t = el("div", "gnotetitle");
  t.appendChild(icon("scroll"));
  t.appendChild(document.createTextNode(" " + n.title));
  g.appendChild(t);
  var ul = document.createElement("ul");
  for(var i = 0; i < n.lines.length; i++){
    var parts = n.lines[i].split(" -> ");
    var li = document.createElement("li");
    li.appendChild(el("span", "gform", parts[0]));
    if(parts.length > 1) li.appendChild(document.createTextNode(" " + parts[1]));
    ul.appendChild(li);
  }
  g.appendChild(ul);
  if(n.warning) g.appendChild(el("p", "gwarn", n.warning));
  return g;
}
function mkInput(cls, ph){
  var i = document.createElement("input");
  i.type = "text";
  if(cls) i.className = cls;
  i.setAttribute("autocomplete", "off");
  i.setAttribute("autocapitalize", "off");
  i.setAttribute("spellcheck", "false");
  if(ph) i.setAttribute("placeholder", ph);
  return i;
}
/* Corta un texto por los marcadores {1}, {2}... y devuelve los trozos.
   Los indices impares del array son el numero del hueco. */
function splitMarks(text){ return String(text).split(/\{(\d+)\}/); }

/* ============================================================
   CABECERA + BARRA DE MEDALLAS
   ============================================================ */
document.title = DATA.meta.title + " - " + DATA.meta.chapter;
document.getElementById("heroChapter").textContent = DATA.meta.chapter;
document.getElementById("heroTitle").textContent = DATA.meta.title;
document.getElementById("heroSub").textContent = DATA.meta.sub;
document.getElementById("heroVerbs").innerHTML = DATA.meta.verbs;

var questBar = document.getElementById("questBar");
var questEls = {};
(function(){
  for(var i = 0; i < DATA.trials.length; i++){
    var t = DATA.trials[i];
    var d = el("div", "medal");
    var mi = el("div", "mi");
    mi.appendChild(icon(t.icon));
    var txt = el("div");
    txt.appendChild(el("div", "mt", t.medal));
    var sc = el("div", "ms", "not tried yet");
    txt.appendChild(sc);
    d.appendChild(mi);
    d.appendChild(txt);
    questBar.appendChild(d);
    questEls[t.key] = { wrap: d, score: sc };
  }
})();
function setQuest(key, got, total){
  var q = questEls[key];
  q.score.textContent = got + " / " + total;
  if(got === total) q.wrap.classList.add("won");
  else q.wrap.classList.remove("won");
}
function resetQuest(key){
  questEls[key].score.textContent = "not tried yet";
  questEls[key].wrap.classList.remove("won");
}

/* ============================================================
   CONSTRUCCION DE LOS TRIALS
   Cada trial declara su type y el motor arma el bloque:
     gap    -> oracion suelta con un hueco corto adentro
     write  -> consigna arriba + una linea entera para escribir
     match  -> forma del verbo + letra a elegir (dos puntos por item)
     choice -> conversacion con opciones para marcar
     cloze  -> texto corrido con huecos numerados
   En gap / write / match la explicacion va PEGADA al item.
   En choice / cloze va en un panel numerado debajo del texto, porque
   pegada a cada hueco rompe la lectura del parrafo (regla del SPECS).
   ============================================================ */
var ROMAN = ["I","II","III","IV","V","VI","VII"];
var trialsHost = document.getElementById("trials");
var TR = {};

function buildTrials(){
  for(var i = 0; i < DATA.trials.length; i++){
    var t = DATA.trials[i];
    var sec = el("section", "card");
    sec.appendChild(el("span", "tag", "Trial " + ROMAN[i]));
    sec.appendChild(el("h2", null, t.title));
    sec.appendChild(el("p", "sub", t.sub));
    if(t.note) sec.appendChild(noteBox(t.note));

    var chips = null;
    if(t.box){
      var vb = el("div", "vaultbox");
      var vt = el("div", "vt");
      vt.appendChild(icon("scroll"));
      vt.appendChild(document.createTextNode(" Verb box"));
      vb.appendChild(vt);
      chips = el("div", "vchips");
      vb.appendChild(chips);
      sec.appendChild(vb);
    }

    var body = el("div", "tbody");
    sec.appendChild(body);

    var panel = null;
    if(t.type === "choice" || t.type === "cloze"){
      panel = el("div", "explist");
      var h = el("h3");
      h.appendChild(icon("scroll"));
      h.appendChild(document.createTextNode(" Why each answer is right"));
      panel.appendChild(h);
      panel.hidden = true;
      sec.appendChild(panel);
    }

    var row = el("div", "btnrow");
    var checkBtn = el("button", "btn", "Check my answers");
    checkBtn.type = "button";
    var resetBtn = el("button", "btn ghost", "Try again");
    resetBtn.type = "button";
    var score = el("span", "scoreline", "");
    row.appendChild(checkBtn); row.appendChild(resetBtn); row.appendChild(score);
    sec.appendChild(row);

    trialsHost.appendChild(sec);

    TR[t.key] = { data: t, body: body, chips: chips, panel: panel, score: score, entries: [] };
    (function(key){
      checkBtn.addEventListener("click", function(){ checkTrial(key); });
      resetBtn.addEventListener("click", function(){ resetTrial(key); });
    })(t.key);

    renderTrial(t.key);
  }
}

function renderTrial(key){
  var st = TR[key], t = st.data, i;
  clear(st.body);
  st.entries = [];
  if(st.panel){
    while(st.panel.childNodes.length > 1) st.panel.removeChild(st.panel.lastChild);
    st.panel.hidden = true;
  }
  if(st.chips){
    clear(st.chips);
    for(i = 0; i < t.box.length; i++){
      var chip = el("span", "vchip", t.box[i]);
      if(t.box[i] === t.boxUsedInExample) chip.className = "vchip done";
      st.chips.appendChild(chip);
    }
  }
  st.score.textContent = "";

  if(t.type === "gap")    renderGap(st, t);
  if(t.type === "write")  renderWrite(st, t);
  if(t.type === "match")  renderMatch(st, t);
  if(t.type === "choice") renderChoice(st, t);
  if(t.type === "cloze")  renderCloze(st, t);
}

/* ---------- gap ---------- */
function renderGap(st, t){
  var i;
  if(t.example){
    var m = el("div", "item model");
    var l = el("div", "sline");
    l.appendChild(el("span", "rn zero", String(t.example.n)));
    var s = el("span");
    s.appendChild(document.createTextNode(t.example.before + " "));
    s.appendChild(el("span", "donetext", t.example.gap));
    s.appendChild(document.createTextNode(" " + t.example.after));
    s.appendChild(el("span", "exampletag", "example"));
    l.appendChild(s);
    m.appendChild(l);
    st.body.appendChild(m);
  }
  for(i = 0; i < t.items.length; i++){
    var d = t.items[i];
    var id = REG.push({ data: d }) - 1;
    var item = el("div", "item");
    item.setAttribute("data-id", String(id));
    var line = el("div", "sline");
    line.appendChild(el("span", "rn", String(d.n)));
    var txt = el("span");
    txt.appendChild(document.createTextNode(d.before + " "));
    var inp = mkInput("w-s");
    txt.appendChild(inp);
    txt.appendChild(document.createTextNode(" " + d.after));
    if(d.verb) txt.appendChild(el("span", "hintword", d.verb));
    line.appendChild(txt);
    item.appendChild(line);
    st.body.appendChild(item);
    st.entries.push({ kind: "input", inputs: [{ el: inp, answers: d.answers }], data: d, holder: item, exp: item });
  }
}

/* ---------- write ---------- */
function renderWrite(st, t){
  var i;
  if(t.example){
    var m = el("div", "item model");
    var p = el("p", "prompt");
    p.appendChild(el("span", "rn zero", String(t.example.n)));
    var sp = el("span");
    sp.appendChild(document.createTextNode(t.example.prompt));
    sp.appendChild(el("span", "exampletag", "example"));
    p.appendChild(sp);
    m.appendChild(p);
    m.appendChild(el("p", "donetext", t.example.gap));
    st.body.appendChild(m);
  }
  for(i = 0; i < t.items.length; i++){
    var d = t.items[i];
    var id = REG.push({ data: d }) - 1;
    var item = el("div", "item");
    item.setAttribute("data-id", String(id));
    var pr = el("p", "prompt");
    pr.appendChild(el("span", "rn", String(d.n)));
    var sp2 = el("span");
    sp2.appendChild(document.createTextNode(d.prompt));
    if(d.keyword) sp2.appendChild(el("span", "hintword", d.keyword));
    pr.appendChild(sp2);
    item.appendChild(pr);
    var inp = mkInput("w-l", "Write the whole sentence here.");
    item.appendChild(inp);
    st.body.appendChild(item);
    st.entries.push({ kind: "input", inputs: [{ el: inp, answers: d.answers }], data: d, holder: item, exp: item });
  }
}

/* ---------- match ---------- */
function renderMatch(st, t){
  var i, j;
  if(t.example){
    var m = el("div", "item model");
    var l = el("div", "sline");
    l.appendChild(el("span", "rn zero", String(t.example.n)));
    var s = el("span");
    s.appendChild(document.createTextNode(t.example.before + " "));
    s.appendChild(el("span", "donetext", t.example.gap));
    s.appendChild(document.createTextNode(" " + t.example.after + "  →  " + t.example.letter));
    s.appendChild(el("span", "exampletag", "example"));
    l.appendChild(s);
    m.appendChild(l);
    st.body.appendChild(m);
  }
  for(i = 0; i < t.items.length; i++){
    var d = t.items[i];
    var id = REG.push({ data: d }) - 1;
    var item = el("div", "item");
    item.setAttribute("data-id", String(id));
    var line = el("div", "sline");
    line.appendChild(el("span", "rn", String(d.n)));
    var txt = el("span");
    txt.appendChild(document.createTextNode(d.before + " "));
    var inp = mkInput("w-s");
    txt.appendChild(inp);
    txt.appendChild(el("span", "hintword", d.verb));
    line.appendChild(txt);
    item.appendChild(line);

    var row = el("div", "matchrow");
    row.appendChild(el("span", "mlab", "Ending"));
    var sel = document.createElement("select");
    var op0 = document.createElement("option");
    op0.value = ""; op0.textContent = "choose...";
    sel.appendChild(op0);
    for(j = 0; j < t.endings.length; j++){
      var op = document.createElement("option");
      op.value = t.endings[j].letter;
      op.textContent = t.endings[j].letter + "  " + t.endings[j].text;
      sel.appendChild(op);
    }
    row.appendChild(sel);
    item.appendChild(row);
    st.body.appendChild(item);

    st.entries.push({ kind: "match", inputs: [{ el: inp, answers: d.answers }], select: sel, data: d, holder: item, exp: item });
  }
}

/* ---------- choice ---------- */
function renderChoice(st, t){
  var conv = el("div", "conv");
  var byNum = {};
  var i, k;
  for(i = 0; i < t.items.length; i++) byNum[t.items[i].n] = t.items[i];
  var exNum = t.example ? t.example.n : -1;

  for(i = 0; i < t.lines.length; i++){
    var ln = t.lines[i];
    var row = el("div", "convline");
    row.appendChild(el("span", "who", ln.who + ":"));
    var said = el("span", "said");
    var parts = splitMarks(ln.text);
    for(k = 0; k < parts.length; k++){
      if(k % 2 === 0){
        if(parts[k] !== "") said.appendChild(document.createTextNode(parts[k]));
      }else{
        var n = parseInt(parts[k], 10);
        said.appendChild(n === exNum ? exampleGroup(t.example) : pickGroup(st, byNum[n]));
      }
    }
    row.appendChild(said);
    conv.appendChild(row);
  }
  st.body.appendChild(conv);
}
function exampleGroup(ex){
  var g = el("span", "optgroup");
  g.appendChild(el("span", "gn", String(ex.n)));
  for(var j = 0; j < ex.options.length; j++){
    var b = el("span", "pickbtn" + (j === ex.correct ? " good" : ""), ex.options[j]);
    g.appendChild(b);
  }
  return g;
}
function pickGroup(st, d){
  var id = REG.push({ data: d }) - 1;
  var g = el("span", "optgroup");
  g.setAttribute("data-id", String(id));
  g.setAttribute("data-sel", "-1");
  g.appendChild(el("span", "gn", String(d.n)));
  var btns = [];
  for(var j = 0; j < d.options.length; j++){
    var b = el("button", "pickbtn", d.options[j]);
    b.type = "button";
    b.setAttribute("data-opt", String(j));
    b.addEventListener("click", onPick);
    g.appendChild(b);
    btns.push(b);
  }
  st.entries.push({ kind: "pick", group: g, btns: btns, data: d, holder: g, exp: null });
  return g;
}
function onPick(ev){
  var b = ev.currentTarget, g = b.parentNode, i;
  var kids = g.querySelectorAll(".pickbtn");
  for(i = 0; i < kids.length; i++) kids[i].classList.remove("on");
  b.classList.add("on");
  g.setAttribute("data-sel", b.getAttribute("data-opt"));
}

/* ---------- cloze ---------- */
function renderCloze(st, t){
  var box = el("div", "clozetext");
  var byNum = {}, i, k;
  for(i = 0; i < t.items.length; i++) byNum[t.items[i].n] = t.items[i];
  var parts = splitMarks(t.text);
  for(k = 0; k < parts.length; k++){
    if(k % 2 === 0){
      if(parts[k] !== "") box.appendChild(document.createTextNode(parts[k]));
    }else{
      var n = parseInt(parts[k], 10);
      box.appendChild(el("span", "gn", String(n)));
      if(t.example && n === t.example.n){
        box.appendChild(el("span", "donetext", t.example.gap));
      }else{
        var d = byNum[n];
        var id = REG.push({ data: d }) - 1;
        var inp = mkInput("");
        inp.setAttribute("data-id", String(id));
        box.appendChild(inp);
        st.entries.push({ kind: "input", inputs: [{ el: inp, answers: d.answers }], data: d, holder: inp, exp: null });
      }
    }
  }
  st.body.appendChild(box);
}

/* ============================================================
   CORRECCION
   ============================================================ */
function markInput(node, ok){
  node.classList.remove("ok", "no");
  node.classList.add(ok ? "ok" : "no");
}
function checkTrial(key){
  var st = TR[key], t = st.data, i, j;
  var got = 0, total = 0;

  /* limpiar explicaciones anteriores */
  var old = st.body.querySelectorAll(".exp");
  for(i = 0; i < old.length; i++) old[i].parentNode.removeChild(old[i]);
  if(st.panel){
    while(st.panel.childNodes.length > 1) st.panel.removeChild(st.panel.lastChild);
  }

  for(i = 0; i < st.entries.length; i++){
    var e = st.entries[i], allOk = true;

    if(e.kind === "input" || e.kind === "match"){
      for(j = 0; j < e.inputs.length; j++){
        var f = e.inputs[j];
        var ok = matches(f.el.value, f.answers);
        markInput(f.el, ok);
        total++;
        if(ok) got++; else allOk = false;
      }
    }
    if(e.kind === "match"){
      var okL = e.select.value === e.data.letter;
      markInput(e.select, okL);
      total++;
      if(okL) got++; else allOk = false;
    }
    if(e.kind === "pick"){
      var sel = parseInt(e.group.getAttribute("data-sel"), 10);
      for(j = 0; j < e.btns.length; j++){
        e.btns[j].classList.remove("on", "good", "bad");
        if(j === e.data.correct) e.btns[j].classList.add("good");
        else if(j === sel) e.btns[j].classList.add("bad");
      }
      total++;
      if(sel === e.data.correct) got++; else allOk = false;
    }

    var answer = e.data.solution || null;
    if(e.kind === "match") answer = e.data.solution + "  →  " + e.data.letter;
    if(e.kind === "pick")  answer = e.data.options[e.data.correct];

    var boxNode = explainBox(allOk, answer, e.data.why, e.data.tip);
    if(e.exp){
      e.exp.appendChild(boxNode);
    }else{
      var wrapItem = el("div", "expitem");
      wrapItem.appendChild(el("span", "en", String(e.data.n)));
      wrapItem.appendChild(boxNode);
      st.panel.appendChild(wrapItem);
    }
  }

  if(st.panel) st.panel.hidden = false;
  if(st.chips) markChips(st);

  st.score.textContent = got + " / " + total + " right";
  setQuest(key, got, total);
}
function markChips(st){
  var t = st.data, used = {}, i;
  used[t.boxUsedInExample] = true;
  for(i = 0; i < st.entries.length; i++){
    var e = st.entries[i];
    if(e.inputs && matches(e.inputs[0].el.value, e.inputs[0].answers)) used[e.data.verb] = true;
  }
  var chips = st.chips.childNodes;
  for(i = 0; i < chips.length; i++){
    var w = chips[i].textContent;
    if(w === t.boxUsedInExample) chips[i].className = "vchip done";
    else chips[i].className = used[w] ? "vchip used" : "vchip";
  }
}
function resetTrial(key){
  renderTrial(key);
  resetQuest(key);
}

/* ============================================================
   CODEX
   ============================================================ */
var codexBody = document.getElementById("codexBody");
var codexToggle = document.getElementById("codexToggle");
(function renderCodex(){
  for(var i = 0; i < DATA.codex.length; i++){
    var g = DATA.codex[i];
    var b = el("div", "gbox");
    b.appendChild(el("h4", null, g.name));
    b.appendChild(el("p", "pat", g.pattern));
    var ps = el("div", "pairs");
    for(var j = 0; j < g.pairs.length; j++){
      var c = el("span", "pchip");
      c.appendChild(document.createTextNode(g.pairs[j][0] + " → "));
      c.appendChild(el("b", null, g.pairs[j][1]));
      ps.appendChild(c);
    }
    b.appendChild(ps);
    codexBody.appendChild(b);
  }
})();
codexToggle.addEventListener("click", function(){
  var open = codexBody.classList.toggle("hidden") === false;
  codexToggle.textContent = open ? "Close the codex" : "Open the codex";
});

/* ============================================================
   ARRANQUE
   ============================================================ */
buildTrials();

})();
</script>
</body>
</html>
